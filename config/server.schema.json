{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackinvent.com/schemas/paris-icc-server.schema.json",
  "title": "Paris ICC server configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "application",
    "server",
    "auth",
    "openai",
    "agent",
    "storage",
    "prim"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "environment",
        "publicOrigin",
        "dataMode"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "publicOrigin": {
          "type": "string",
          "format": "uri"
        },
        "dataMode": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "port",
        "trustProxy",
        "distDirectory"
      ],
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "trustProxy": {
          "type": "boolean"
        },
        "distDirectory": {
          "type": "string"
        },
        "maxRequestBodyBytes": {
          "type": "integer",
          "minimum": 16384,
          "maximum": 1048576
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionSecret",
        "secureCookies"
      ],
      "oneOf": [
        {
          "required": [
            "accessCode"
          ]
        },
        {
          "required": [
            "accessCodeHash"
          ]
        }
      ],
      "properties": {
        "accessCode": {
          "type": "string",
          "minLength": 8,
          "maxLength": 200
        },
        "accessCodeHash": {
          "type": "string",
          "minLength": 20
        },
        "sessionSecret": {
          "type": "string",
          "anyOf": [
            {
              "minLength": 32
            },
            {
              "pattern": "^\\$\\{[A-Z][A-Z0-9_]*\\}$"
            }
          ]
        },
        "cookieName": {
          "type": "string"
        },
        "sessionTtlMinutes": {
          "type": "integer",
          "minimum": 15,
          "maximum": 10080
        },
        "secureCookies": {
          "type": "boolean"
        },
        "maxFailedAttempts": {
          "type": "integer",
          "minimum": 2,
          "maximum": 30
        },
        "failureWindowSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 86400
        }
      }
    },
    "openai": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "apiKey",
        "model",
        "allowedModels"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "apiKey": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "reasoningEffort": {
          "enum": [
            null,
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 256,
          "maximum": 16000
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 5000,
          "maximum": 120000
        },
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "allowedModels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instructions",
        "presets"
      ],
      "properties": {
        "instructions": {
          "type": "string",
          "minLength": 100
        },
        "maxPromptCharacters": {
          "type": "integer",
          "minimum": 200,
          "maximum": 12000
        },
        "maxToolOutputCharacters": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 200000
        },
        "maxToolRounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "runTtlMinutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 240
        },
        "maxRunsPerSession": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "requestsPerMinute": {
          "type": "integer",
          "minimum": 2,
          "maximum": 120
        },
        "presets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "prompt"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2500
              }
            }
          }
        },
        "logMaxEntries": {
          "type": "integer",
          "minimum": 50,
          "maximum": 10000
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "databasePath",
        "tickIntervalMs",
        "agentRuntimePath"
      ],
      "properties": {
        "databasePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "tickIntervalMs": {
          "type": "integer",
          "minimum": 250,
          "maximum": 5000,
          "default": 1000,
          "description": "Wall-clock interval between operations-engine ticks; 1000 ms preserves real-time cadence at speed x1."
        },
        "agentRuntimePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "prim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "apiKey",
        "apiUrl"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "apiKey": {
          "type": "string"
        },
        "apiUrl": {
          "type": "string",
          "format": "uri"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 30000
        }
      }
    }
  }
}
